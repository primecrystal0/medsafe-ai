# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=Cluster0
MONGODB_DB_NAME=medsafer

# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# (Optional/unused unless you switch back) Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Flask settings
BACKEND_PORT=5000
FLASK_ENV=development